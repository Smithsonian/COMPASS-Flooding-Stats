            <gco:CharacterString>Survey of marsh soil and vegetation properties in Barataria Basin (Louisiana, USA) from 20180501 to 20230727</gco:CharacterString>
          </gmd:title>
          <gmd:date gco:nilReason="unknown"/>
          <gmd:citedResponsibleParty>
